# Environment configuration (may contain deployment URLs or secrets)
.env
.env.*
!.env.example
!**/.env.example

# Node / Vite
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


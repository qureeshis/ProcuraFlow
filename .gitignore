*.db
!backend-python/app/bootstrap.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test and coverage output
.coverage
htmlcov/
coverage/


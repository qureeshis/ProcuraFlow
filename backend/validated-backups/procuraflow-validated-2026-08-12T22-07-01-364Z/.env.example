PORT=4000
JWT_SECRET=change-this-secret-in-production
DB_PATH=./procuraflow.db
# Set these for every purchased production installation. Once the company name
# is applied, the database rejects attempts to rebrand it for another company.
LICENSED_COMPANY_NAME=
# Comma-separated host names including ports when applicable.
LICENSED_HOSTNAMES=
# Enable only when ProcuraFlow is behind one controlled reverse proxy. When
# false, client-supplied forwarded-host and forwarded-IP headers are ignored.
TRUST_PROXY=false
# Explicit browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
